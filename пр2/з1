import os
import csv
import random
from threading import Thread, Lock
from concurrent.futures import ProcessPoolExecutor
import time
from statistics import mean


def process_faculty(file, input_folder, lock, processed_faculties):
    grades = []
    with open(os.path.join(input_folder, file), newline="", encoding="utf-8") as f:
        reader = csv.DictReader(f)
        for row in reader:
            grades.append(int(row["grade"]))

    count = len(grades)
    failed = len([g for g in grades if g == 2])
    success_rate = (count - failed) / count * 100

    report = {
        "file": file,
        "count": count,
        "sum": sum(grades),
        "avg": mean(grades),
        "excellent": len([g for g in grades if g == 5]),
        "good": len([g for g in grades if g == 4]),
        "satisfactory": len([g for g in grades if g == 3]),
        "failed": failed,
        "success_rate": success_rate
    }

    with lock:
        processed_faculties.append(report)


def save_report(args):
    report, output_folder = args
    file = report["file"]

    faculty_name = file.replace("факультет_", "").replace(".csv", "")

    out_path = os.path.join(output_folder, f"отчёт_{faculty_name}.txt")
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(f"Факультет: {faculty_name}\n")
        f.write(f"Студентов: {report['count']}\n")
        f.write(f"Сумма баллов: {report['sum']}\n")
        f.write(f"Средний балл: {report['avg']:.2f}\n")
        f.write(f"Отличников (5): {report['excellent']}\n")
        f.write(f"Хорошистов (4): {report['good']}\n")
        f.write(f"Троечников (3): {report['satisfactory']}\n")
        f.write(f"Двоечников (2): {report['failed']}\n")
        f.write(f"Процент успевающих: {report['success_rate']:.2f}%\n")


def main():
    input_folder = "university/input"
    output_folder = "university/output"
    os.makedirs(input_folder, exist_ok=True)
    os.makedirs(output_folder, exist_ok=True)

    faculty_names = [
        "Математика", "Физика", "Информатика", "Химия", "Биология",
        "Экономика", "Юриспруденция", "Филология", "История", "Психология"
    ]

    for name in faculty_names:
        path = os.path.join(input_folder, f"факультет_{name}.csv")
        if not os.path.exists(path):
            with open(path, "w", newline="", encoding="utf-8") as f:
                writer = csv.writer(f)
                writer.writerow(["student_id", "grade"])
                for student_id in range(1, 1001):
                    writer.writerow([student_id, random.randint(2, 5)])

    faculty_files = [f for f in os.listdir(input_folder) if f.endswith('.csv')]

    lock = Lock()
    processed_faculties = []

    start_time = time.time()

    threads = []
    for file in faculty_files:
        thread = Thread(
            target=process_faculty,
            args=(file, input_folder, lock, processed_faculties)
        )
        thread.start()
        threads.append(thread)

    for thread in threads:
        thread.join()

    end_time = time.time()
    print(f"Этап 1 (многопоточная обработка факультетов) завершен за {end_time - start_time:.2f} секунд")

    tasks = [(r, output_folder) for r in processed_faculties]

    start_time = time.time()

    with ProcessPoolExecutor() as executor:
        executor.map(save_report, tasks)

    end_time = time.time()
    print(f"Этап 2 (многопроцессное сохранение отчётов) завершен за {end_time - start_time:.2f} секунд")

    print("Задача завершена. Проанализируйте результаты выполнения для улучшения производительности.")


if __name__ == '__main__':
    main()